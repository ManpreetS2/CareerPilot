# CareerPilot AI — copy this file to .env and fill in keys locally.
# Never commit .env.

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Default provider used by the prompt harness if --provider is omitted.
DEFAULT_LLM_PROVIDER=gemini

# --- Job sources ---
# Adzuna free tier: register at https://developer.adzuna.com/ to get both values.
# Without them the scout still runs, using RemoteOK and manual URLs only.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

# RemoteOK's public API needs no key.

# Max listings pulled per source per scout run.
SCOUT_RESULTS_PER_SOURCE=25

# --- App ---
DATABASE_URL=sqlite:///./data/careerpilot.db
BACKEND_URL=http://localhost:8000
LOG_LEVEL=INFO

# --- Auth ---
SESSION_COOKIE_NAME=careerpilot_session
SESSION_TTL_DAYS=30
# Set to true for any deployment served over https. Leave false for local
# http dev — a Secure cookie is silently dropped by the browser over http.
COOKIE_SECURE=false

# --- Frontend (Vite) ---
# Copy into frontend/.env.local if you need a non-default API URL.
VITE_API_BASE_URL=http://localhost:8000
