# CareerPilot AI — copy this file to .env and fill in keys locally.
# Never commit .env.

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Default provider used by the prompt harness if --provider is omitted.
DEFAULT_LLM_PROVIDER=gemini

# --- App ---
DATABASE_URL=sqlite:///./data/careerpilot.db
BACKEND_URL=http://localhost:8000
LOG_LEVEL=INFO

# --- Frontend (Vite) ---
# Copy into frontend/.env.local if you need a non-default API URL.
VITE_API_BASE_URL=http://localhost:8000
