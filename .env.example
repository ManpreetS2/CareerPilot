# CareerPilot AI — copy this file to .env and fill in keys locally.
# Never commit .env.

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Default provider used by the prompt harness if --provider is omitted.
DEFAULT_LLM_PROVIDER=gemini

# Sequential providers for candidate profile, Job Intelligence,
# application materials, and mock-interview answer feedback.
# Blank keeps historical Gemini-only behavior.
# Supported names: ollama, gemini, anthropic, openai. No duplicates.
LLM_PROVIDER_ORDER=ollama,gemini

# Resume parsing is interactive and does not inherit the global order.
# Gemini first; Ollama is the local fallback. Do not put qwen3:14b here.
RESUME_LLM_PROVIDER_ORDER=gemini,ollama
RESUME_GEMINI_MODEL=gemini-3.5-flash-lite
RESUME_GEMINI_TIMEOUT_SECONDS=30
RESUME_OLLAMA_MODEL=qwen3.5:4b
RESUME_OLLAMA_READ_TIMEOUT_SECONDS=60
RESUME_OLLAMA_KEEP_ALIVE=2m
RESUME_OLLAMA_NUM_CTX=8192
RESUME_OLLAMA_NUM_PREDICT=2048

# Full-job requirement extraction (not Fit scoring). Do not use qwen3:14b.
JOB_REQUIREMENTS_LLM_PROVIDER_ORDER=gemini,ollama
JOB_REQUIREMENTS_GEMINI_MODEL=gemini-3.5-flash-lite
JOB_REQUIREMENTS_OLLAMA_MODEL=qwen3.5:4b
JOB_REQUIREMENTS_VERIFY_TOP_N=10

# --- Ollama (private, never public) ---
# Host computer (this PC): keep Ollama bound to localhost. Never set
# OLLAMA_HOST=0.0.0.0, never use Tailscale Funnel, never port-forward 11434.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:14b
OLLAMA_CONNECT_TIMEOUT_SECONDS=3
OLLAMA_READ_TIMEOUT_SECONDS=180
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=4096
# Teammate computer: do not install Ollama or pull the model. Join the same
# Tailscale tailnet and point at the host Serve URL only in this gitignored file:
# OLLAMA_BASE_URL=https://<host-device>.<tailnet>.ts.net
# Only the host installs and pulls qwen3:14b. Each developer keeps a separate
# .env and a separate Gemini key. Never commit a real Tailscale hostname.

# --- Job sources ---
# Adzuna free tier: register at https://developer.adzuna.com/ to get both values.
# Without them the scout still runs, using RemoteOK and manual URLs only.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

# RemoteOK's public API needs no key.

# Greenhouse and Lever also need no key (public boards APIs), but have no
# cross-company search — each board/company is listed individually. Comma-
# separated board tokens / company slugs to scout; ships with a small
# working default so "Find Jobs" shows results out of the box. Override to
# watch different companies.
GREENHOUSE_BOARD_TOKENS=stripe,airbnb,robinhood,discord,reddit,gitlab
LEVER_COMPANY_SLUGS=ro

# Remotive's public API also needs no key. Its terms require crediting
# Remotive and linking back to the original listing (already satisfied —
# job.source drives the UI's source badge and job.url stores the Remotive
# URL) and ask for infrequent polling — only called from a user-triggered
# "Find Jobs" click here, never on a schedule.

# Jobicy and Himalayas public remote-job APIs also need no key. Each does
# server-side keyword search, so Find Jobs calls them once per saved role.
# No ADZUNA-style credentials — leave this comment-only.

# Max listings pulled per source per scout run (Greenhouse/Lever: aggregated
# across all of that source's configured boards, not per board).
SCOUT_RESULTS_PER_SOURCE=25

# --- App ---
DATABASE_URL=sqlite:///./data/careerpilot.db
BACKEND_URL=http://localhost:8000
LOG_LEVEL=INFO

# --- Auth ---
SESSION_COOKIE_NAME=careerpilot_session
SESSION_TTL_DAYS=30
# Set to true for any deployment served over https. Leave false for local
# http dev — a Secure cookie is silently dropped by the browser over http.
COOKIE_SECURE=false
APP_ENV=development
# Comma-separated frontend origins. Never use * with credentialed CORS.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Exact chrome-extension://<id>. Leave blank to disable extension CORS.
EXTENSION_ORIGIN=

# --- Frontend (Vite) ---
# Copy into frontend/.env.local only for a non-local API. Leave unset locally
# so the UI talks to http://<this-page-hostname>:8000 and localhost vs
# 127.0.0.1 cannot split the session cookie across sites.
# VITE_API_BASE_URL=https://api.example.com
