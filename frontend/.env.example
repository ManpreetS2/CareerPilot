# Local API origin. Leave unset so the app uses http://<this-page-hostname>:8000.
# That keeps localhost and 127.0.0.1 as the same cookie site (SameSite=Lax).
# A local alias copied here is also rewritten to the page hostname at runtime.
# An explicit non-local URL is used unchanged.
# VITE_API_BASE_URL=https://api.example.com
