{
  "manifest_version": 3,
  "name": "CareerPilot",
  "version": "0.3.0",
  "description": "Native Chrome side panel companion for Greenhouse and Lever job pages. Shows Potential or Verified Match, eligibility, and safe autofill preview. Never submits.",
  "action": {
    "default_title": "CareerPilot"
  },
  "side_panel": {
    "default_path": "dist/sidepanel.html"
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "cookies", "sidePanel", "tabs"],
  "host_permissions": ["http://127.0.0.1:8000/*", "http://localhost:8000/*"],
  "optional_host_permissions": ["https://*.greenhouse.io/*", "https://*.lever.co/*"]
}
