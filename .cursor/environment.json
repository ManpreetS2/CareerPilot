{
  "name": "CareerPilot AI",
  "install": "bash .cursor/install.sh",
  "terminals": [
    {
      "name": "backend",
      "command": "source .venv/bin/activate && uvicorn backend.main:app --host 0.0.0.0 --port 8000 --reload"
    },
    {
      "name": "frontend",
      "command": "cd frontend && npm run dev -- --host 0.0.0.0 --port 5173"
    }
  ],
  "ports": [
    { "name": "backend", "port": 8000 },
    { "name": "frontend", "port": 5173 }
  ]
}
